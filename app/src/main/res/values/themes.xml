<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TitanTrack" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/titan_accent</item>
        <item name="colorOnPrimary">@color/titan_text_primary</item>
        <item name="android:colorBackground">@color/titan_background</item>
        <item name="colorSurface">@color/titan_surface</item>
        <item name="android:statusBarColor">@color/titan_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="textInputStyle">@style/Widget.TitanTrack.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.TitanTrack.BottomNavigationView</item>
        <item name="materialCardViewStyle">@style/Widget.TitanTrack.CardView</item>
    </style>

    <style name="Theme.TitanTrack" parent="Base.Theme.TitanTrack" />

    <!-- Estilo por defecto de los campos de texto de TitanTrack -->
    <style name="Widget.TitanTrack.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/titan_input_stroke</item>
        <item name="android:textColorHint">@color/titan_text_secondary</item>
        <item name="hintTextColor">@color/titan_text_secondary</item>
        <item name="endIconTint">@color/titan_text_secondary</item>
        <item name="passwordToggleTint">@color/titan_text_secondary</item>
    </style>

    <style name="Widget.TitanTrack.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/titan_surface</item>
        <item name="itemIconTint">@color/titan_nav_item</item>
        <item name="itemTextColor">@color/titan_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.TitanTrack.BottomNavigationView.ActiveIndicator</item>
    </style>

    <style name="Widget.TitanTrack.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/titan_nav_indicator</item>
    </style>

    <!-- Estilo por defecto de las tarjetas (MaterialCardView) de TitanTrack -->
    <style name="Widget.TitanTrack.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/titan_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

</resources>